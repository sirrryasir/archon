# Archon LLM Provider Settings
# Choose one of: ollama, openai, anthropic, google
ARCHON_PROVIDER=ollama
ARCHON_MODEL=qwen3-coder:480b-cloud

# Ollama Settings
OLLAMA_URL=http://localhost:11434

# OpenAI Settings (if ARCHON_PROVIDER=openai)
# ARCHON_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic Settings (if ARCHON_PROVIDER=anthropic)
# ARCHON_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Google Gemini Settings (if ARCHON_PROVIDER=google)
# ARCHON_MODEL=gemini-1.5-pro-latest
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Fallback Model (optional)
# If the primary model fails (timeout, rate limit, 5xx),
# Archon will automatically retry with this model.
# ARCHON_FALLBACK_PROVIDER=ollama
# ARCHON_FALLBACK_MODEL=qwen2.5:32b

